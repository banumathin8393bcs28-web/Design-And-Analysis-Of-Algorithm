#include <iostream>
#include <string>
using namespace std;
int main() {
    string T, P;
    int comparisons = 0;
    int alignments = 0;
    cout << "Enter the text: ";
    getline(cin, T);
    cout << "Enter the pattern: ";
    getline(cin, P);
    int n = T.length();
    int m = P.length();
    cout << "\nString Searching:-\n";
    for (int i = 0; i <= n - m; i++) {
        alignments++;
        cout << "\nAlignment " << alignments<< " (Pattern at index " << i << "):\n";
        int j = 0;
        while (j < m) {
            comparisons++;
            cout << "Compare T[" << i + j << "] = '" << T[i + j]<< "' with P[" << j << "] = '" << P[j] << "'";
            if (T[i + j] == P[j]) {
                cout << " -> Match\n";
                j++;
            } else {
                cout << " -> Mismatch\n";
                break;
            }
        }
        if (j == m) {
            cout << "\nPattern found at index " << i << endl;
            cout << "Total Alignments: " << alignments << endl;
            cout << "Total Comparisons: " << comparisons << endl;
            return 0;
        }
    }
    cout << "\nPattern not found.\n";
    cout << "Total Alignments: " << alignments << endl;
    cout << "Total Comparisons: " << comparisons << endl;
    return 0;
}

