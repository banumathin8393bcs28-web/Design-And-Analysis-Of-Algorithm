#include <iostream>
using namespace std;
#define RED     "\033[31m"
#define GREEN   "\033[32m"
#define RESET   "\033[0m"
int main() {
    int n, passes = 0;
    cout << "Enter number of elements: ";
    cin >>n;
    int* a = new int[n];
    cout << "Enter elements:\n";
    for (int j = 0; j < n; j++) {
        cin >> a[j];
    }
    cout << "\nInitial array:\n";
    for (int j = 0; j < n; j++)
        cout << a[j] << " ";
    cout << "\n\n";
    for (int k = 0; k < n - 1; k++) {
        cout << "Pass " << k + 1 << ":\n";
        for (int j = 0; j < n - 1 - k; j++) {
            if (a[j] > a[j + 1]) {
                cout << "Swapping " << RED << a[j] << " " << a[j + 1] << RESET << " -> ";
                int temp = a[j];
                a[j] = a[j + 1];
                a[j + 1] = temp;
            } else {
                cout << "No Swapping " << RED << a[j] << " " << a[j + 1] << RESET << " -> ";
            }
            for (int j2 = 0; j2 < n; j2++) {
                if (j2 >= n - k - 1)
                    cout << GREEN << a[j2] << " " << RESET;
                else
                    cout << a[j2] << " ";
            }
            cout << "\n";
        }
        passes++;
        cout << "Array after pass " << k + 1 << ": ";
        for (int j = 0; j < n; j++) {
            if (j >= n - k - 1)
                cout << GREEN << a[j] << " " << RESET;
            else
                cout << a[j] << " ";
        }
        cout << "\n\n";
    }
    cout << "Final Sorted Array:\n";
    for (int j = 0; j < n; j++) {
        cout << GREEN << a[j] << " " << RESET;
    }
    cout << "\nTotal No. Of Passes = " << passes << endl;
    return 0;
}
