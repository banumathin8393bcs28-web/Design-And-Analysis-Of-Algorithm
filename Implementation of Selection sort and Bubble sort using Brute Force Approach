#include <iostream>
using namespace std;
#define RED     "\033[31m"
#define GREEN   "\033[32m"
#define RESET   "\033[0m"
int main() {
    int n, i, j, min, temp;
    cout << "Enter number of elements: ";
    cin >> n;
    int a[n];
    cout << "Enter "<<n<<" elements:\n";
    for (i = 0; i < n; i++) {
        cin >> a[i];
    }
    cout << "\nThe array before sorting : ";
    for (i = 0; i < n; i++) {
        cout << a[i] << " ";
    }
    cout << endl;
     for (i = 0; i < n - 1 ; i++) {
        min = i;
        cout << "\nPass : " << i + 1 << ":\n";
        for (j = i + 1; j < n; j++) {
            if (a[j] < a[min]) {
                min = j;
            }
        }
        temp = a[i];
        a[i] = a[min];
        a[min] = temp;
        cout << "Array status: ";
        for (j = 0; j < n; j++) {
            if (j == i || j == min) {
                cout << RED << a[j] << RESET << " ";
            }
            else if (j < i) {
                cout << GREEN << a[j] << RESET << " ";
            }
            else {
                cout << a[j] << " ";
            }
        }
        cout << endl;
    }
    cout << "\nFinal sorted array:\n";
    for (i = 0; i < n; i++) {
        cout << GREEN << a[i] << RESET << " ";
    }
    return 0;
}
