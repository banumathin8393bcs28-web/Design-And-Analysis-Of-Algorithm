#include <iostream>
#include <iomanip>
using namespace std;
void printCount(int Count[], int n) {
    for (int i = 0; i < n; i++) {
        cout << setw(3) << Count[i] << " ";
    }
    cout << endl;
}
void comparisonCountingSort(int A[], int n) {
    int Count[n] = {0};
    int S[n];
    cout << "\n Initial Array A[0.." << n-1 << "]: ";
    for (int i = 0; i < n; i++) cout << A[i] << " ";
    cout << "\n\nInitial Count[]: ";
    printCount(Count, n);
    for (int i = 0; i <= n - 2; i++) {
        for (int j = i + 1; j <= n - 1; j++) {
            if (A[i] < A[j])
                Count[j]++;
            else
                Count[i]++;
        }
        cout << "After pass i = " << i << " Count[]: ";
        printCount(Count, n);
    }
    cout << "\nFinal Count[]: ";
    printCount(Count, n);
    for (int i = 0; i < n; i++) {
        S[Count[i]] = A[i];
    }
    cout << "\nArray S[0.." << n-1 << "]: ";
    for (int i = 0; i < n; i++) cout << S[i] << " ";
}
int main() {
    int n;
    cout << "Enter number of elements: ";
    cin >> n;
    int A[n];
    cout << "Enter elements:\n";
    for (int i = 0; i < n; i++) cin >> A[i];
    comparisonCountingSort(A, n);
    return 0;
}
